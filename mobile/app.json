{
  "expo": {
    "name": "Emergency Breakdown Assistance",
    "slug": "emergency-breakdown-assistance",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Emergency Breakdown Assistance to use your location to find nearby help."
        }
      ]
    ],
    "android": {
      "package": "com.emergencybreakdown.app",
      "usesCleartextTraffic": true
    },
    "ios": {
      "bundleIdentifier": "com.emergencybreakdown.app"
    }
  }
}
